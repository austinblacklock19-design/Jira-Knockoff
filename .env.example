# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker"

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) app registration for company sign-in
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Local development only: lets you sign in as any seeded user without Microsoft.
# Never enable in production.
ALLOW_DEV_LOGIN="true"
