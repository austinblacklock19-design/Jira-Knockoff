generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum TicketType {
  TASK
  BUG
  STORY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        String      @id @default(cuid())
  name      String
  email     String      @unique
  image     String?
  role      CompanyRole @default(MEMBER)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  teams           TeamMember[]
  assigned        Ticket[]        @relation("assignee")
  reported        Ticket[]        @relation("reporter")
  comments        Comment[]
  activity        ActivityEvent[]
  notifications   Notification[]
  watching        Watcher[]
}

model Team {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  members   TeamMember[]
  projects  Project[]
}

model TeamMember {
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   TeamRole @default(MEMBER)

  @@id([teamId, userId])
}

model Project {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  archived    Boolean  @default(false)
  ticketSeq   Int      @default(0)
  createdAt   DateTime @default(now())

  team     Team     @relation(fields: [teamId], references: [id])
  teamId   String
  statuses Status[]
  tickets  Ticket[]
}

model Status {
  id        String         @id @default(cuid())
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  color     String         @default("#64748b")
  order     Int
  category  StatusCategory
  tickets   Ticket[]

  @@index([projectId, order])
}

model Ticket {
  id          String     @id @default(cuid())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  number      Int
  title       String
  description String     @default("")
  type        TicketType @default(TASK)
  priority    Priority   @default(MEDIUM)
  status      Status     @relation(fields: [statusId], references: [id])
  statusId    String
  assignee    User?      @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  String?
  reporter    User       @relation("reporter", fields: [reporterId], references: [id])
  reporterId  String
  dueDate     DateTime?
  labels      String[]   @default([])
  rank        Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  comments      Comment[]
  activity      ActivityEvent[]
  notifications Notification[]
  watchers      Watcher[]

  @@unique([projectId, number])
  @@index([statusId, rank])
  @@index([assigneeId])
}

model Comment {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Watcher {
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  @@id([userId, ticketId])
}
